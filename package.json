{
  "name": "miluimnet",
  "version": "2.0.0",
  "private": true,
  "description": "מילואימנט - רשת חברתית למילואימניקים (Node.js, Express, MongoDB, React)",
  "type": "commonjs",
  "main": "server/server.js",
  "scripts": {
    "setup": "npm install && npm --prefix client install",
    "dev": "concurrently -n server,client -c green,cyan \"npm run server\" \"npm --prefix client run dev\"",
    "server": "node --watch server/server.js",
    "build": "npm --prefix client run build",
    "start": "node server/server.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-mongo": "^6.0.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "mongodb": "^7.7.0",
    "mongoose": "^9.11.2"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
