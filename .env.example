# העתיקו את הקובץ הזה ל-.env ומלאו את הערכים האמיתיים.
# הקובץ .env לא עולה ל-git (הוא ב-.gitignore), כי יש בו מידע סודי.

# כתובת החיבור ל-MongoDB Atlas (Database > Connect > Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/miluimnet

# מחרוזת אקראית וארוכה, משמשת להצפנת ה-cookie של ההתחברות
SESSION_SECRET=change-me-to-a-long-random-string

# הפורט שהשרת מאזין לו
PORT=3000

# הסיסמה של כל משתמשי הדוגמה ש-npm run seed יוצר (בחרו סיסמה משלכם, לפחות 6 תווים)
SEED_PASSWORD=choose-a-demo-password
